    "finding_info": {
        "uid": "placeholder_uid",
        "title": "Defender for Endpoint - AMSI and Antivirus blocked credential-theft tooling",
        "desc": "AMSI scanned the in-memory contents of powershell.exe on ws-fin-042.contoso.corp and identified the script as Backdoor:PowerShell/Bovter.A. Defender Antivirus subsequently quarantined the process while it was executing. The same process tree then attempted LSASS memory access via rundll32.exe loading diag.dll - a classic credential dumping pattern. MITRE ATT&CK: T1003.001 (LSASS Memory), T1059.001 (PowerShell), T1140 (Deobfuscate/Decode Files or Information).",
        "src_url": "https://security.microsoft.com/alerts/df0a9b8c-7d6e-5f4a-3b2c-1d0e9f8a7b6c",
