    "finding_info": {
        "uid": "placeholder_uid",
        "title": "Defender for Endpoint - Suspicious 'Bovter' backdoor was prevented",
        "desc": "Malicious activity matching the PowerShell-based Bovter backdoor family was detected by Microsoft Defender Antivirus on ws-fin-042.contoso.corp. A malicious LNK shortcut spawned cmd.exe which launched powershell.exe with an obfuscated, base64-encoded command line. The script attempted to establish a reverse TCP connection to a known command-and-control server (195.201.59.127:4443). AMSI detected the script content and the AV engine quarantined the process. MITRE ATT&CK: T1059.001 (PowerShell), T1027 (Obfuscated Files or Information), T1140 (Deobfuscate/Decode Files or Information).",
        "src_url": "https://security.microsoft.com/alerts/be8e7d6c-5f4a-3b2c-1d0e-9f8a7b6c5d4e",
