          {"rename": {"from": "unmapped.OSPlatform", "to": "endpoint.os"}},
          {"rename": {"from": "unmapped.DeviceType", "to": "endpoint.type"}}
        ]
      },
      {
        "predicate": "unmapped.TableName = 'AlertInfo'",
        "transformations": [
          {"constant": {"value": "threat_intelligence_indicators", "field": "event.category"}},
          {"rename": {"from": "unmapped.AlertId", "to": "event.externalID"}},
          {"rename": {"from": "unmapped.Title", "to": "event.classification"}},
          {"rename": {"from": "unmapped.Category", "to": "event.mitreTactic"}},
          {"rename": {"from": "unmapped.Severity", "to": "event.outcome.result"}},
          {"rename": {"from": "unmapped.AttackTechniques", "to": "event.mitreTechnique.name"}},
          {"rename": {"from": "unmapped.DetectionSource", "to": "event.source"}},
          {"rename": {"from": "unmapped.ServiceSource", "to": "event.outcome.reason"}}
        ]
      }
    ]
  }
}
